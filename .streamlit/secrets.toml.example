# Copy these into Streamlit Community Cloud → your app → Settings → Secrets.
# Never commit a real secrets.toml.

GEMINI_API_KEY = "paste-a-dedicated-key-for-the-public-app"

# Guardrails for the public demo (optional; these are the defaults)
MAX_RUNS_PER_SESSION = 10
MAX_RUNS_PER_DAY = 200
RUN_COOLDOWN_SECONDS = 10
MAX_UPLOAD_MB = 20
MAX_TEXT_CHARS = 10000
MAX_QUESTIONS = 10

# YouTube links for the Video guides tab (unlisted videos work)
VIDEO_URL_OVERVIEW = "https://youtu.be/..."
VIDEO_URL_CHOICE = "https://youtu.be/..."
VIDEO_URL_NOUL = "https://youtu.be/..."
VIDEO_URL_SCORE = "https://youtu.be/..."
